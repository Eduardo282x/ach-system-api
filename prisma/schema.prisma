generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id                 Int                 @id @default(autoincrement())
  name               String
  username           String
  password           String
  role               Role
  email              String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  deleted            Boolean             @default(false)
  cashDrawerSessions CashDrawerSession[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]
}

model Clients {
  id        Int       @id @default(autoincrement())
  fullName  String
  identify  String    @unique @default("")
  address   String    @default("")
  phone     String    @default("")
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  invoices  Invoice[]
}

model ExchangeRate {
  id        Int              @id @default(autoincrement())
  name      String
  currency  ExchangeRateType
  rate      Decimal          @db.Decimal(10, 2)
  isDefault Boolean          @default(false)
  date      DateTime         @default(now())
  createdAt DateTime         @default(now())
  usdRate   Invoice[]        @relation("UsdRate")
  eurRate   Invoice[]        @relation("EurRate")
}

model TypePayment {
  id             Int              @id @default(autoincrement())
  name           String
  currency       ExchangeRateType @default(USD)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  paymentDetails PaymentDetail[]
}

model Product {
  id                    Int                    @id @default(autoincrement())
  name                  String
  presentation          String
  barcode               String                 @unique
  purchasePrice         Decimal                @db.Decimal(10, 2)
  price                 Decimal                @db.Decimal(10, 2)
  currency              ExchangeRateType       @default(USD)
  stock                 Decimal                @db.Decimal(10, 3)
  isDetail              Boolean                @default(false)
  parentId              Int?
  unitsDetail           Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  deleted               Boolean                @default(false)
  ivaId                 Int
  iva                   Iva                    @relation(fields: [ivaId], references: [id])
  historyMovements      InventoryMovement[]
  invoiceItems          InvoiceItem[]
  productParent         Product?               @relation("ConvertUnits", fields: [parentId], references: [id])
  productChild          Product[]              @relation("ConvertUnits")
  inventoryEntryDetails InventoryEntryDetail[]

  @@index([parentId])
}

model Iva {
  id         Int       @id @default(autoincrement())
  name       String
  percentage Decimal   @db.Decimal(5, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  products   Product[]
}

model InventoryMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  quantity  Decimal      @db.Decimal(10, 3)
  type      MovementType
  reason    String?
  userId    Int
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id])
  user      Users        @relation(fields: [userId], references: [id])
}

model Invoice {
  id               Int     @id @default(autoincrement())
  invoiceNumber    String  @unique
  totalAmountBs    Decimal @db.Decimal(65, 2)
  totalAmountUsd   Decimal @db.Decimal(65, 2)
  totalReceivedBs  Decimal @db.Decimal(65, 2)
  totalReceivedUsd Decimal @db.Decimal(65, 2)
  totalChangeBs    Decimal @db.Decimal(65, 2)
  totalChangeUsd   Decimal @db.Decimal(65, 2)

  exchangeRateUsdId Int
  exchangeRateEurId Int
  exchangeRateUsd   ExchangeRate @relation("UsdRate", fields: [exchangeRateUsdId], references: [id])
  exchangeRateEur   ExchangeRate @relation("EurRate", fields: [exchangeRateEurId], references: [id])

  status         InvoiceStatus     @default(PAID)
  userId         Int
  customerId     Int
  sessionId      Int
  createdAt      DateTime          @default(now())
  customer       Clients           @relation(fields: [customerId], references: [id])
  session        CashDrawerSession @relation(fields: [sessionId], references: [id])
  user           Users             @relation(fields: [userId], references: [id])
  items          InvoiceItem[]
  paymentDetails PaymentDetail[]

  @@index([sessionId])
  @@index([createdAt])
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  productId Int
  unitPrice Decimal  @db.Decimal(10, 2)
  costPrice Decimal? @db.Decimal(10, 2)
  quantity  Decimal  @db.Decimal(10, 3)
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model PaymentDetail {
  id             Int              @id @default(autoincrement())
  invoiceId      Int
  paymentTypeId  Int
  amountReceived Decimal          @default(0) @db.Decimal(10, 2)
  amountChange   Decimal          @default(0) @db.Decimal(10, 2)
  amountNet      Decimal          @default(0) @db.Decimal(10, 2)
  amountNetBs    Decimal          @db.Decimal(10, 2)
  currency       ExchangeRateType
  denominations  Json?
  invoice        Invoice          @relation(fields: [invoiceId], references: [id])
  paymentType    TypePayment      @relation(fields: [paymentTypeId], references: [id])

  @@index([invoiceId])
}

model CurrencyDenomination {
  id       Int              @id @default(autoincrement())
  currency ExchangeRateType
  value    Decimal          @db.Decimal(10, 2)
  active   Boolean          @default(true)
}

model CashDrawerSession {
  id                Int           @id @default(autoincrement())
  userId            Int
  cashDrawerId      Int
  openedAt          DateTime      @default(now())
  closedAt          DateTime?
  openingBalance    Decimal       @db.Decimal(65, 2)
  openingBalanceUsd Decimal       @default(0) @db.Decimal(65, 2)
  closingBalance    Decimal?      @db.Decimal(65, 2)
  closingBalanceUsd Decimal?      @db.Decimal(65, 2)
  totalSales        Decimal       @default(0) @db.Decimal(65, 2)
  totalInUsd        Decimal       @default(0) @db.Decimal(65, 2)
  totalInBs         Decimal       @default(0) @db.Decimal(65, 2)
  status            SessionStatus @default(OPEN)
  user              Users         @relation(fields: [userId], references: [id])
  cashDrawer        CashDrawer    @relation(fields: [cashDrawerId], references: [id])
  invoices          Invoice[]
}

model CashDrawer {
  id                 Int                 @id @default(autoincrement())
  name               String
  cashDrawerSessions CashDrawerSession[]
}

enum Role {
  ADMIN
  CAJERO
  SUPERVISOR
}

enum ExchangeRateType {
  BS
  USD
  EUR
}

enum MovementType {
  SALE
  RESTOCK
  CONVERSION
  ADJUSTMENT
  RETURN
}

enum InvoiceStatus {
  PAID
  PENDING
  CANCELLED
}

enum SessionStatus {
  OPEN
  CLOSED
}

model InventoryEntry {
  id                    Int                    @id @default(autoincrement())
  controlNumber         String                 @unique
  title                 String                 @default("")
  description           String                 @default("")
  date                  DateTime
  supplierId            Int
  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventoryEntryDetails InventoryEntryDetail[]
}

model InventoryEntryDetail {
  id               Int            @id @default(autoincrement())
  inventoryEntryId Int
  inventoryEntry   InventoryEntry @relation(fields: [inventoryEntryId], references: [id])
  productId        Int
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Decimal        @db.Decimal(10, 3)
  unitPrice        Decimal        @db.Decimal(10, 2)
  subtotal         Decimal        @db.Decimal(10, 2)
}

model Supplier {
  id               Int              @id @default(autoincrement())
  name             String
  identify         String           @unique @default("")
  address          String           @default("")
  phone            String           @default("")
  deleted          Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  inventoryEntries InventoryEntry[]
}
